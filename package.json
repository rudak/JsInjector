{
  "name": "js-injector",
  "version": "2.0.0",
  "description": "Modern JavaScript library for injecting values into the browser context",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "types/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "js-src",
    "types"
  ],
  "scripts": {
    "build": "rollup -c",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint js-src __tests__",
    "lint:fix": "eslint js-src __tests__ --fix",
    "format": "prettier --write \"js-src/**/*.js\" \"__tests__/**/*.js\"",
    "format:check": "prettier --check \"js-src/**/*.js\" \"__tests__/**/*.js\"",
    "prepublishOnly": "npm run lint && npm test && npm run build",
    "prepare": "npm run build"
  },
  "keywords": [
    "injection",
    "javascript",
    "constants",
    "variables"
  ],
  "author": "",
  "license": "Apache-2.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "rollup": "^4.9.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
